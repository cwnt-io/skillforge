# shellcheck shell=bash
# direnv runs this file on cd. CI enters the devshell without direnv, so CI
# builds without kache and needs none.
use flake

# Route each rustc call through the kache of the host. KACHE_DISABLED=1 runs one
# command without it.
export RUSTC_WRAPPER=kache

# Two warnings of the exobrain CLI. Each one exits 0 and moves nothing.
exobrain hooks status || true
exobrain store-guard --daily || true
